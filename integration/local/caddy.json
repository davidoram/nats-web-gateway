{
  "admin": {
    "disabled": true
  },
  "apps": {
    "http": {
      "servers": {
        "local": {
          "listen": [":8080"],
          "routes": [
            {
              "match": [{"path": ["/health"]}],
              "handle": [
                {
                  "handler": "nats_web_gateway",
                  "nats": {
                    "urls": ["nats://nats:4222"],
                    "username": "{env.NATS_USER}",
                    "password": "{env.NATS_PASSWORD}",
                    "connect_timeout": "5s",
                    "reconnect_wait": "250ms",
                    "max_reconnects": -1,
                    "drain_timeout": "5s"
                  },
                  "routes": [{
                    "name": "health_fixture",
                    "path": "/health",
                    "methods": ["GET"],
                    "subject": "demo.echo",
                    "timeout": "2s",
                    "max_request_body_bytes": 1024,
                    "max_reply_bytes": 1024,
                    "response": {
                      "mode": "raw",
                      "headers": ["Content-Type"],
                      "content_type": "text/plain",
                      "service_error_statuses": {"4001": 400}
                    },
                    "stream_mode": "request_reply"
                  }]
                },
                {"handler": "static_response", "body": "ready\n"}
              ]
            }
          ]
        }
      }
    }
  }
}

{
  "admin": {
    "disabled": true
  },
  "apps": {
    "http": {
      "servers": {
        "local": {
          "listen": [":8080"],
          "routes": [
            {
              "match": [{"path": ["/health", "/echo/*", "/errors/*", "/pets", "/pets/*", "/rpc/*"]}],
              "handle": [
                {
                  "handler": "nats_web_gateway",
                  "nats": {
                    "urls": ["nats://nats:4222"],
                    "username": "{env.NATS_USER}",
                    "password": "{env.NATS_PASSWORD}",
                    "connect_timeout": "5s",
                    "reconnect_wait": "250ms",
                    "max_reconnects": -1,
                    "drain_timeout": "5s"
                  },
                  "routes": [{
                    "name": "echo_fixture",
                    "path": "/echo/{id}",
                    "methods": ["POST"],
                    "subject": "demo.echo.{id}.{view}",
                    "parameters": {
                      "id": {"source": "path", "name": "id", "pattern": "^[A-Za-z0-9_-]+$"},
                      "view": {"source": "query", "name": "view", "pattern": "^[A-Za-z0-9_-]+$"}
                    },
                    "request_headers": ["Content-Type", "Traceparent"],
                    "timeout": "2s",
                    "max_request_body_bytes": 1024,
                    "max_reply_bytes": 1024,
                    "response": {
                      "mode": "binary",
                      "headers": ["Content-Type"],
                      "content_type": "text/plain",
                      "service_error_statuses": {"4001": 400}
                    },
                    "stream_mode": "request_reply"
                  }, {
                    "name": "rest_create_pet", "path": "/pets", "methods": ["POST"], "subject": "pets.rest.create",
                    "timeout": "2s", "max_request_body_bytes": 65536, "max_reply_bytes": 65536,
                    "response": {"mode": "json", "content_type": "application/json", "service_error_statuses": {"4001": 400, "4041": 404}}, "stream_mode": "request_reply"
                  }, {
                    "name": "rest_list_pets", "path": "/pets", "methods": ["GET"], "subject": "pets.rest.list",
                    "timeout": "2s", "max_request_body_bytes": 1024, "max_reply_bytes": 65536,
                    "response": {"mode": "json", "content_type": "application/json"}, "stream_mode": "request_reply"
                  }, {
                    "name": "rest_get_pet", "path": "/pets/{id}", "methods": ["GET"], "subject": "pets.rest.get.{id}",
                    "parameters": {"id": {"source": "path", "name": "id", "pattern": "^[A-Za-z0-9_-]+$"}},
                    "timeout": "2s", "max_request_body_bytes": 1024, "max_reply_bytes": 65536,
                    "response": {"mode": "json", "content_type": "application/json", "service_error_statuses": {"4041": 404}}, "stream_mode": "request_reply"
                  }, {
                    "name": "rest_update_pet", "path": "/pets/{id}", "methods": ["PUT"], "subject": "pets.rest.update.{id}",
                    "parameters": {"id": {"source": "path", "name": "id", "pattern": "^[A-Za-z0-9_-]+$"}},
                    "timeout": "2s", "max_request_body_bytes": 65536, "max_reply_bytes": 65536,
                    "response": {"mode": "json", "content_type": "application/json", "service_error_statuses": {"4001": 400, "4041": 404}}, "stream_mode": "request_reply"
                  }, {
                    "name": "rest_delete_pet", "path": "/pets/{id}", "methods": ["DELETE"], "subject": "pets.rest.delete.{id}",
                    "parameters": {"id": {"source": "path", "name": "id", "pattern": "^[A-Za-z0-9_-]+$"}},
                    "timeout": "2s", "max_request_body_bytes": 1024, "max_reply_bytes": 65536,
                    "response": {"mode": "json", "content_type": "application/json", "service_error_statuses": {"4041": 404}}, "stream_mode": "request_reply"
                  }, {
                    "name": "rpc_create_pet", "path": "/rpc/pets.CreatePet", "methods": ["POST"], "subject": "pets.rpc.CreatePet",
                    "timeout": "2s", "max_request_body_bytes": 65536, "max_reply_bytes": 65536,
                    "response": {"mode": "json", "content_type": "application/json", "service_error_statuses": {"4001": 400}}, "stream_mode": "request_reply"
                  }, {
                    "name": "rpc_get_pet", "path": "/rpc/pets.GetPet", "methods": ["POST"], "subject": "pets.rpc.GetPet",
                    "timeout": "2s", "max_request_body_bytes": 65536, "max_reply_bytes": 65536,
                    "response": {"mode": "json", "content_type": "application/json", "service_error_statuses": {"4001": 400, "4041": 404}}, "stream_mode": "request_reply"
                  }, {
                    "name": "rpc_update_pet", "path": "/rpc/pets.UpdatePet", "methods": ["POST"], "subject": "pets.rpc.UpdatePet",
                    "timeout": "2s", "max_request_body_bytes": 65536, "max_reply_bytes": 65536,
                    "response": {"mode": "json", "content_type": "application/json", "service_error_statuses": {"4001": 400, "4041": 404}}, "stream_mode": "request_reply"
                  }, {
                    "name": "rpc_delete_pet", "path": "/rpc/pets.DeletePet", "methods": ["POST"], "subject": "pets.rpc.DeletePet",
                    "timeout": "2s", "max_request_body_bytes": 65536, "max_reply_bytes": 65536,
                    "response": {"mode": "json", "content_type": "application/json", "service_error_statuses": {"4001": 400, "4041": 404}}, "stream_mode": "request_reply"
                  }, {
                    "name": "rpc_list_pets", "path": "/rpc/pets.ListPets", "methods": ["POST"], "subject": "pets.rpc.ListPets",
                    "timeout": "2s", "max_request_body_bytes": 1024, "max_reply_bytes": 65536,
                    "response": {"mode": "json", "content_type": "application/json"}, "stream_mode": "request_reply"
                  }, {
                    "name": "missing_fixture",
                    "path": "/errors/no-responders",
                    "methods": ["GET"],
                    "subject": "demo.missing",
                    "timeout": "2s",
                    "max_request_body_bytes": 1024,
                    "max_reply_bytes": 1024,
                    "response": {"mode": "binary", "content_type": "application/octet-stream"},
                    "stream_mode": "request_reply"
                  }, {
                    "name": "permission_fixture",
                    "path": "/errors/permission",
                    "methods": ["GET"],
                    "subject": "denied.subject",
                    "timeout": "2s",
                    "max_request_body_bytes": 1024,
                    "max_reply_bytes": 1024,
                    "response": {"mode": "binary", "content_type": "application/octet-stream"},
                    "stream_mode": "request_reply"
                  }, {
                    "name": "malformed_fixture",
                    "path": "/errors/malformed",
                    "methods": ["GET"],
                    "subject": "demo.malformed",
                    "timeout": "2s",
                    "max_request_body_bytes": 1024,
                    "max_reply_bytes": 1024,
                    "response": {"mode": "json", "content_type": "application/json"},
                    "stream_mode": "request_reply"
                  }, {
                    "name": "slow_fixture",
                    "path": "/errors/timeout",
                    "methods": ["GET"],
                    "subject": "demo.slow",
                    "timeout": "100ms",
                    "max_request_body_bytes": 1024,
                    "max_reply_bytes": 1024,
                    "response": {"mode": "json", "content_type": "application/json"},
                    "stream_mode": "request_reply"
                  }]
                },
                {"handler": "static_response", "body": "ready\n"}
              ]
            }
          ]
        }
      }
    }
  }
}
